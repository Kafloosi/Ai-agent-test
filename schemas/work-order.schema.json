{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/work-order.schema.json",
  "title": "WorkOrder",
  "description": "The unit of scheduling. Self-contained and independently verifiable: an agent receiving only this plus its context pack must be able to complete the work.",
  "type": "object",
  "required": ["id", "type", "title", "risk_class", "acceptance_criteria", "budget", "state"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^WO-[0-9]+$" },
    "parent": { "type": "string", "description": "Epic or parent work order id" },
    "type": {
      "enum": ["specify", "design", "decompose", "implement", "test", "fix", "review", "integrate", "document", "release"]
    },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string" },
    "risk_class": {
      "enum": ["low", "medium", "high"],
      "description": "Set by the Architect. Drives model tier, gate strictness, human approval, and rollout policy."
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Work orders that must reach MERGED before this becomes QUEUED. Must not form a cycle."
    },
    "capabilities_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Matched against worker pool capabilities by the deterministic routing table."
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "URIs of frozen interface contracts this work order must satisfy. Deviations are reported, never taken unilaterally."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Falsifiable Given/When/Then statements. The only definition of done.",
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "test_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Populated by the Test Engineer. Every criterion must map to at least one test before Gate 2 can pass."
          }
        }
      }
    },
    "files_hint": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expected scope. Used for module-lease affinity and for detecting scope expansion."
    },
    "budget": {
      "type": "object",
      "required": ["tokens", "max_attempts"],
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "usd": { "type": "number", "minimum": 0 },
        "wall_clock_s": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "state": {
      "enum": ["DRAFT", "SPECIFIED", "PLANNED", "QUEUED", "ASSIGNED", "IN_PROGRESS", "SUBMITTED", "VERIFYING", "REVISION", "REPLAN", "APPROVED", "INTEGRATING", "MERGED", "RELEASED", "ROLLED_BACK", "FAILED_RUN", "BLOCKED", "ESCALATED", "ABANDONED"]
    },
    "attempts": { "type": "integer", "minimum": 0 },
    "escalation_rung": { "type": "integer", "minimum": 0, "maximum": 6 },
    "assigned_pool": { "type": "string" },
    "model_tier": { "enum": ["T1", "T2", "T3"] },
    "base_commit": { "type": "string", "description": "Pinned commit the run is verified against." },
    "spend": {
      "type": "object",
      "properties": {
        "tokens": { "type": "integer" },
        "usd": { "type": "number" },
        "wall_clock_s": { "type": "integer" }
      }
    }
  }
}
