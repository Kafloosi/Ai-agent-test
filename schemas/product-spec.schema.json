{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/product-spec.schema.json",
  "title": "ProductSpec",
  "description": "Output of the Requirements Analyst. The separation of assumptions (proceed, but recorded) from open_questions (block, ask a human) is what stops the fleet building the wrong thing efficiently.",
  "type": "object",
  "required": ["id", "summary", "acceptance_criteria", "non_goals"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "source_request": { "type": "string" },
    "summary": { "type": "string" },
    "user_stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["as_a", "i_want", "so_that"],
        "properties": {
          "as_a": { "type": "string" },
          "i_want": { "type": "string" },
          "so_that": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then", "falsifiable"],
        "properties": {
          "id": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "falsifiable": {
            "type": "boolean",
            "const": true,
            "description": "The Analyst must self-check that an automated test could fail this criterion. Anything that cannot be made falsifiable becomes an open_question instead."
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit scope fence. Everything not stated is out of scope; naming it prevents agents from expanding scope on their own initiative."
    },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "data_and_privacy": {
      "type": "object",
      "properties": {
        "handles_pii": { "type": "boolean" },
        "data_classes": { "type": "array", "items": { "type": "string" } },
        "retention_notes": { "type": "string" }
      }
    },
    "nfrs": {
      "type": "array",
      "description": "Non-functional requirements. Become the budgets the Performance agent enforces.",
      "items": {
        "type": "object",
        "properties": {
          "metric": { "type": "string" },
          "budget": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Recorded and proceeded on. Reviewed at Gate 2."
    },
    "open_questions": {
      "type": "array",
      "description": "BLOCKING. The work order cannot leave DRAFT while any remain unanswered.",
      "items": {
        "type": "object",
        "required": ["question", "blocks"],
        "properties": {
          "question": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
